# Copy to apps/web/.env.local and fill in. Never commit the real file.
# Values marked (Phase N) are not read by the web app until that phase.

# Where the browser calls the API  (Phase 2)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Auth.js. Generate AUTH_SECRET with: npx auth secret  (Phase 3)
AUTH_SECRET=
# GitHub OAuth app (Settings > Developer settings > OAuth Apps), callback http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Same value as API_JWT_SECRET in apps/api/.env  (Phase 3)
API_JWT_SECRET=

# Public VAPID key, same as VAPID_PUBLIC_KEY in apps/api/.env  (Phase 5)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Sentry DSN for the browser (optional)  (Phase 5)
NEXT_PUBLIC_SENTRY_DSN=
