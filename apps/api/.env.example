# Copy to apps/api/.env and fill in. Never commit the real .env.
# Values marked (Phase N) are not read by the API until that phase.

NODE_ENV=development
PORT=4000

# Database: local Docker Compose Postgres. In staging/production this is the Neon pooled URL.  (Phase 2)
DATABASE_URL=postgresql://transit:transit_local@localhost:5433/sg_transit

# Redis: local Docker Compose Redis. In staging/production this is the Upstash rediss:// URL.  (Phase 2)
REDIS_URL=redis://localhost:6379
# Key prefix so staging and production can share one Upstash database: dev | stg | prod
REDIS_KEY_PREFIX=dev
# Daily Redis command budget before optional writes stop (see docs/ARCHITECTURE.md)
REDIS_DAILY_COMMAND_BUDGET=12000

# LTA DataMall account key (request one at https://datamall.lta.gov.sg)  (Phase 2)
LTA_ACCOUNT_KEY=
LTA_BASE_URL=https://datamall2.mytransport.sg/ltaodataservice

# Comma-separated list of web origins allowed by CORS  (Phase 2)
CORS_ORIGINS=http://localhost:3000

# Shared with apps/web: signs the short-lived API token. Generate with: openssl rand -base64 32  (Phase 3)
API_JWT_SECRET=

# Bearer secret for /internal/* endpoints (Cloudflare Worker, stop sync)  (Phase 5)
CRON_SECRET=

# Web Push keys. Generate with: npx web-push generate-vapid-keys  (Phase 5)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Sentry DSN for the API (optional)  (Phase 5)
SENTRY_DSN=
