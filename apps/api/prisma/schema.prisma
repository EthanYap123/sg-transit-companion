// Data model: docs/ERD.md. Migrations live in prisma/migrations and are applied by `prisma migrate deploy`.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// A copy of LTA's BusStops dataset, refreshed by POST /internal/stops/sync.
model BusStop {
  code        String          @id @db.Char(5)
  description String
  roadName    String          @map("road_name")
  latitude    Float
  longitude   Float
  syncedAt    DateTime        @map("synced_at") @db.Timestamptz(3)
  favourites  FavouriteStop[]

  @@map("bus_stops")
}

enum StopSyncStatus {
  running
  ok
  failed
}

/// One row per bus stop sync, for /health and debugging.
model StopSyncRun {
  id          String         @id @default(uuid()) @db.Uuid
  startedAt   DateTime       @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt  DateTime?      @map("finished_at") @db.Timestamptz(3)
  recordCount Int            @default(0) @map("record_count")
  status      StopSyncStatus @default(running)
  error       String?

  @@index([startedAt])
  @@map("stop_sync_runs")
}

/// One row per signed-in person, created the first time the API sees their token.
model User {
  id          String          @id @default(uuid()) @db.Uuid
  /// "<provider>:<provider user id>", e.g. google:1234567
  authSubject String          @unique @map("auth_subject")
  name        String?
  email       String?
  imageUrl    String?         @map("image_url")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt  DateTime        @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  favourites  FavouriteStop[]

  @@map("users")
}

/// A stop a user saved. Deleting the user deletes these; a stop someone saved is never deleted.
model FavouriteStop {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  busStopCode String   @map("bus_stop_code") @db.Char(5)
  busStop     BusStop  @relation(fields: [busStopCode], references: [code], onDelete: Restrict)
  label       String?  @db.VarChar(30)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([userId, busStopCode])
  @@index([userId, sortOrder])
  @@map("favourite_stops")
}
